# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าจริง — ห้าม commit .env ตัวจริงขึ้น git

# PostgreSQL: postgresql+psycopg2://<user>:<password>@<host>:5432/<db_name>
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/sai_mu_db

# สุ่มค่าใหม่จริงจังด้วย: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ใช้กับ /chat (RAG) — ห้ามพิมพ์ค่าคีย์จริงไว้ในไฟล์ที่จะ commit ขึ้น git
# หรือแปะในแชท/README เด็ดขาด ถ้าคีย์เคยหลุดไปที่ไหนมาก่อน ให้ revoke แล้ว
# สร้างใหม่ใน Google AI Studio ก่อนใส่ค่าตรงนี้
GEMINI_API_KEY=CHANGE_ME

# --- ก่อนขึ้นจริง (ดู docs/PRODUCTION_CHECKLIST.md) ---
# development (ดีฟอลต์) | production — production จะไม่ยอมสตาร์ทถ้ายังใช้ค่า default ที่ไม่ปลอดภัย
ENVIRONMENT=development
# โดเมนของเว็บแอปที่อนุญาตเรียก API คั่นด้วย , ("*" ใช้ตอน dev เท่านั้น)
CORS_ORIGINS=*
# กันเดารหัสผ่าน: ผิดเกิน LOGIN_MAX_FAILS ครั้งต่ออีเมลภายใน LOGIN_FAIL_WINDOW_MINUTES นาที = พักชั่วคราว
LOGIN_MAX_FAILS=5
LOGIN_FAIL_WINDOW_MINUTES=15
LOGIN_IP_MAX_FAILS=20
